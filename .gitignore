# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignorar arquivos de documentação
*.md
!README.md

# Ignorar dados do PostgreSQL (gerados em runtime)
**/data/pg/

# Logs (gerados em runtime)
faculdade-back-end/logs/*.log

# Node modules
**/node_modules/

# Build outputs
**/dist/
**/.next/

# Generated Prisma Client
**/generated/prisma/
